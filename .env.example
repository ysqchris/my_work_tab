# 复制为 .env 后填写：cp .env.example .env
# .env 已被 git 忽略，不要提交。生成随机串：openssl rand -hex 24

# ---------- 必填：访问控制 ----------
# 登录工作台的密码（不设置则服务不会启动）
APP_PASSWORD=
# Cookie 签名密钥，建议随机 48 位；不填则由 APP_PASSWORD 派生
SECRET_KEY=
# 外部 Agent / 脚本调用 /api/* 的令牌：请求头 Authorization: Bearer <API_TOKEN>
API_TOKEN=

# ---------- 必填：数据库（compose 内置 MySQL） ----------
MYSQL_ROOT_PASSWORD=
DB_NAME=worktable
DB_USER=worktable
DB_PASSWORD=

# ---------- 访问方式 ----------
# A. 无域名，HTTP 直连 http://<服务器IP>/ ：保持默认即可
APP_BIND=0.0.0.0
APP_PORT=80
COOKIE_SECURE=0
TRUST_PROXY=0
# B. 有域名并启用 HTTPS（docker compose --profile https up -d）：改成下面这样
# DOMAIN=work.example.com
# APP_BIND=127.0.0.1
# APP_PORT=8000
# COOKIE_SECURE=1
# TRUST_PROXY=1

# ---------- 可选：功能密钥（不填对应模块会提示未配置） ----------
# 微信读书（wrk- 开头）
WEREAD_API_KEY=
# 资讯摘要 / 洞察 / AI 助手（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
HYUNYUAN_API_KEY=
HYUNYUAN_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
HYUNYUAN_MODEL=hy3
# ima 知识库同步
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# B 站博主视频抓取（可选，提升成功率）
BILI_COOKIE=
# GitHub API（可选，提高限流额度）
GITHUB_TOKEN=
# 灯塔运营数据只在内网可用，公网留空即可（会自动跳过）
TAI_IT_TOKEN=

# ---------- 运行参数 ----------
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
# 0 = 关闭资讯/豆瓣定时抓取
WORKTAB_SCHEDULERS=1
# 构建时 PyPI 源（腾讯云服务器走内网镜像更快）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
